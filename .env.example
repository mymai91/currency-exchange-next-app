# API Configuration for Frontend (BFF Pattern)
# The frontend makes requests to its own /api routes, not directly to the backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Backend NestJS API URL (used by Next.js API routes only)
BACKEND_API_URL=http://localhost:3000

# App Configuration
NEXT_PUBLIC_APP_NAME="Currency Exchange"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# Optional: Rate limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=60000
